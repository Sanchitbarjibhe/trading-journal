// prisma/schema.prisma

datasource db {
  provider = "postgresql" // किंवा तू जो डेटाबेस वापरत असशील तो (mysql/sqlite)
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// १. युझर मॉडेल (Authentication साठी)
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trades    Trade[]  // युझरचे सर्व ट्रेड्स ट्रॅक करण्यासाठी रिलेशनशिप
}

// २. ट्रेड्स मॉडेल (तुझा सायकोलॉजिकल आणि टेक्निकल डेटा)
model Trade {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pair            String   // उदा. XAUUSD, BTC, NIFTY
  type            String   // BUY / SELL
  entryPrice      Float
  exitPrice       Float
  quantity        Int
  pnl             Float    // Profit or Loss amount
  emotion         String   // FOMO, Greed, Disciplined, Revenge (तुझा सायकॉलॉजीचा गाभा!)
  notes           String?  // ट्रेडचे वैयक्तिक नोट्स
  createdAt       DateTime @default(now())
}